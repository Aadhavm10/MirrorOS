# Copy to voice/voice.env to override defaults. Real env vars win over this file.

# MIRROR_URL=http://localhost:3000

# Wake word. Either a bundled openWakeWord model:
#   alexa_v0.1  hey_mycroft_v0.1  hey_jarvis_v0.1  hey_rhasspy_v0.1
# or an absolute path to a custom .onnx you trained (e.g. "hey mirror").
# There is no bundled "hey mirror" — see docs/voice-setup.md to train one.
# WAKE_MODEL=hey_jarvis_v0.1

# Lower = wakes more easily but more false triggers. 0.5 is a good start;
# a freshly trained custom model often needs ~0.6-0.7 to stop self-triggering.
# WAKE_THRESHOLD=0.5
# WHISPER_BIN=whisper-cli
# WHISPER_MODEL=/absolute/path/to/models/ggml-base.en.bin
# PIPER_VOICE=/absolute/path/to/models/en_US-lessac-medium.onnx

# Device index or name substring from --list-devices; empty = system default
# AUDIO_INPUT_DEVICE=
# AUDIO_OUTPUT_DEVICE=
