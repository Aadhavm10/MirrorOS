PORT=3000
TZ=America/Chicago

# Weather location default (Richardson, TX). Once saved from the /settings
# page, server/config.json takes precedence over these.
WEATHER_LAT=32.9483
WEATHER_LON=-96.7299

# iCloud CalDAV — get an app-specific password at appleid.apple.com
CALDAV_USERNAME=your@apple.id
CALDAV_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Set to 1 to serve fake calendar events (preview layout without credentials)
MOCK_CALENDAR=0

# Morning commute — Google Routes API (see docs/google-maps-setup.md)
GOOGLE_MAPS_API_KEY=
COMMUTE_ORIGIN=123 Home St, Richardson, TX
COMMUTE_DEST=456 Work Ave, Dallas, TX
COMMUTE_DEPART=07:30
COMMUTE_LABEL=Work

# Set to 1 to serve fake commute times (preview layout without an API key)
MOCK_COMMUTE=0
