# Secrets and machine-level settings only.
#
# Everything a person would want to change — names, weather city, commute
# addresses and departure times, layout, sleep schedule — is edited on the
# phone at http://<mirror-ip>:3000/settings and stored in server/config.json.
# Nothing in this file needs touching again once the mirror is set up.

PORT=3000

# Server timezone. Not a preference — Node uses it for every date calculation,
# so it has to be set before the process starts. The weather city's timezone is
# picked separately on the /settings page.
TZ=America/Chicago

# --- Keys ------------------------------------------------------------------

# iCloud CalDAV — get an app-specific password at appleid.apple.com.
# The mirror shows two people; each needs their own Apple ID and its own
# app-specific password. The unsuffixed pair is person 1, _B is person 2.
# Leave the _B pair blank to run the mirror with only one calendar.
CALDAV_USERNAME=your@apple.id
CALDAV_PASSWORD=xxxx-xxxx-xxxx-xxxx
CALDAV_USERNAME_B=
CALDAV_PASSWORD_B=

# Commute times — Google Routes API (see docs/google-maps-setup.md).
# Only the key lives here; both people's addresses are set on /settings.
GOOGLE_MAPS_API_KEY=

# Voice assistant brain (Claude Haiku 4.5) — create a key at console.anthropic.com
# POST /api/assistant returns 503 until this is set.
ANTHROPIC_API_KEY=

# Spotify playback control (Premium required — see docs/spotify-setup.md).
# After setting these, visit http://127.0.0.1:3000/spotify/login once.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Dev toggles -----------------------------------------------------------
# Serve fake data so the layout can be previewed without credentials.
MOCK_CALENDAR=0
MOCK_COMMUTE=0
