PORT=3000
TZ=America/Chicago

# Weather location default (Richardson, TX). Once saved from the /settings
# page, server/config.json takes precedence over these.
WEATHER_LAT=32.9483
WEATHER_LON=-96.7299

# iCloud CalDAV — get an app-specific password at appleid.apple.com
CALDAV_USERNAME=your@apple.id
CALDAV_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Set to 1 to serve fake calendar events (preview layout without credentials)
MOCK_CALENDAR=0

# Morning commute — Google Routes API (see docs/google-maps-setup.md).
# Only the key lives here; addresses + departure time are set from the
# /settings page (stored in server/config.json). The COMMUTE_* vars below
# are optional first-run seeds.
GOOGLE_MAPS_API_KEY=
COMMUTE_ORIGIN=
COMMUTE_DEST=
COMMUTE_DEPART=07:30
COMMUTE_LABEL=Work

# Set to 1 to serve fake commute times (preview layout without an API key)
MOCK_COMMUTE=0

# Voice assistant brain (Claude Haiku 4.5) — create a key at console.anthropic.com
# POST /api/assistant returns 503 until this is set.
ANTHROPIC_API_KEY=

# Spotify playback control (Premium required — see docs/spotify-setup.md).
# After setting these, visit http://127.0.0.1:3000/spotify/login once.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
